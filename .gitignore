/bin/
/node_modules/
.env
.env.*
!.env.local.sample
kubeconfig.yml
.idea
.DS_Store

# Chart-local secret overrides (per-release, never committed)
helm/*/values.secret.yaml

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local dev overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan output files
*tfplan*

# Backend config generated from env vars (contains account ID)
backend.conf

# Ignore .terraform.lock.hcl file (uncomment if you prefer not to version this file)
# .terraform.lock.hcl
# Git worktrees — Claude Code's native worktree tool writes here; this is the
# canonical location (gitignored). Narrow ignore: the rest of .claude/ stays
# tracked, so shared agent config (csw.json) is versioned with the repo.
.claude/worktrees/

# Claude Code local settings and per-session scratch
.claude/settings.local.json
.claude/*.lock

# Superpowers design specs + implementation plans: generated per-session as
# working artifacts, never tracked. Both paths: the skills default to
# docs/superpowers/, and repos whose docs/ is published content use the root.
superpowers/
docs/superpowers/
.superpowers/

# Working notes — investigation records, scratch analysis, session notes. Same
# rationale as docs/superpowers/ above: they earn their keep while a ticket is
# being built and reviewed, then go stale fast (PIDs, bench state, host facts)
# while still reading as authoritative because they are checked in. Durable
# conclusions belong in CLAUDE.md, an ADR or a code comment; the narrative and
# evidence belong on the ticket.
docs/notes/
