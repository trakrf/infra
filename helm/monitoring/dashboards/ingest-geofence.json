{
  "title": "TrakRF — Ingest, geofence and alarms",
  "uid": "trakrf-ingest-geofence",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Ingest",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "MQTT messages by result",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(ingest_messages_total{job=\"trakrf-backend\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reads parsed vs asset_scans inserted",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(ingest_reads_parsed_total{job=\"trakrf-backend\"}[5m]))",
          "legendFormat": "parsed"
        },
        {
          "expr": "sum(rate(ingest_asset_scans_inserted_total{job=\"trakrf-backend\"}[5m]))",
          "legendFormat": "inserted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reads dropped by reason",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(ingest_reads_dropped_total{job=\"trakrf-backend\"}[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Geofence",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Evaluated vs fired",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum(rate(geofence_evaluated_total{job=\"trakrf-backend\"}[5m]))",
          "legendFormat": "evaluated"
        },
        {
          "expr": "sum(rate(geofence_alarms_fired_total{job=\"trakrf-backend\"}[5m]))",
          "legendFormat": "fired"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Suppressed by reason",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(geofence_alarms_suppressed_total{job=\"trakrf-backend\"}[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errors",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "expr": "sum(rate(geofence_fire_errors_total{job=\"trakrf-backend\"}[5m]))",
          "legendFormat": "fire errors"
        },
        {
          "expr": "sum(rate(geofence_event_write_errors_total{job=\"trakrf-backend\"}[5m]))",
          "legendFormat": "event write errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Output-device calls",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Call p95 by kind",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(alarm_device_call_duration_seconds_bucket{job=\"trakrf-backend\"}[5m])))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Calls by kind and outcome",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "expr": "sum by (kind, outcome) (rate(alarm_device_call_duration_seconds_count{job=\"trakrf-backend\"}[5m]))",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    }
  ]
}
